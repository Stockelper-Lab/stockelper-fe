generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "windows", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                       Int                       @id @default(autoincrement())
  kis_app_key              String
  kis_app_secret           String
  kis_access_token         String?
  account_no               String
  created_at               DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                 @default(now()) @db.Timestamp(6)
  email                    String                    @unique
  name                     String                    @default("")
  nickname                 String                    @unique
  password                 String                    @default("")
  investor_type            String                    @default("안정형")
  conversations            Conversation[]
  portfolioRecommendations PortfolioRecommendation[]
}

model survey {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  answer     Json
}

model sessions {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String
  expires_at DateTime
}

model Conversation {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  lastActive DateTime @default(now()) @map("last_active")
  title      String?
  userId     Int?     @map("user_id")
  messages   Chat[]
  user       users?   @relation(fields: [userId], references: [id])

  @@map("conversations")
}

model Chat {
  id                    String       @id @default(uuid())
  createdAt             DateTime     @default(now()) @map("created_at")
  messageId             String       @map("message_id")
  role                  String
  content               String
  timestamp             DateTime
  subgraphData          Json?        @map("subgraph_data")
  tradingActionData     Json?        @map("trading_action_data")
  errorMessage          String?      @map("error_message")
  humanFeedbackResponse Boolean?     @map("human_feedback_response")
  conversationId        String       @map("conversation_id")
  jobId                 String?      @map("job_id")
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chats")
}

model PortfolioRecommendation {
  id           String   @id @default(uuid())
  userId       Int      @map("user_id")
  investorType String   @map("investor_type")
  result       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  jobId        String?  @map("job_id")
  user         users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@map("portfolio_recommendations")
}

model backtesting {
  id                       String    @id
  job_id                   String    @unique
  user_id                  Int
  request_source           String    @default("llm")
  status                   String
  input_json               Json      @default("{}")
  output_json              Json      @default("{}")
  result_file_path         String?
  report_file_path         String?
  error_message            String?
  analysis_status          String    @default("pending")
  analysis_md              String?
  analysis_json            Json      @default("{}")
  analysis_model           String?
  analysis_prompt_version  String?
  analysis_error_message   String?
  analysis_started_at      DateTime? @db.Timestamptz(6)
  analysis_completed_at    DateTime? @db.Timestamptz(6)
  analysis_elapsed_seconds Float?
  elapsed_seconds          Float?
  started_at               DateTime? @db.Timestamptz(6)
  completed_at             DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @db.Timestamptz(6)

  @@index([analysis_status, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)], map: "backtesting_user_created_at_idx")
}
